{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "michuno-configurator",
  "compatibility_date": "2026-05-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "mockup.michuno.com.mx/*", "zone_name": "michuno.com.mx" }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
